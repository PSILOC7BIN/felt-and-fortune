# Optional: environment variables are read from the process, not automatically from this file.
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=data/ap-toolbox.sqlite3
# Set to the externally served HTTPS origin in production.
PUBLIC_ORIGIN=http://127.0.0.1:8000
COOKIE_SECURE=0
# Account recovery email (optional for local preview; required for email recovery).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
