{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "felt-and-fortune",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "server.py"
      ],
      "port": 8000
    },
    {
      "name": "felt-and-fortune-qa",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "scripts/qa_server.py"
      ],
      "port": 8001
    },
    {
      "name": "felt-and-fortune-phone",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-c",
        "import os,runpy;os.environ['HOST']='0.0.0.0';runpy.run_path('server.py',run_name='__main__')"
      ],
      "port": 8000
    },
    {
      "name": "felt-and-fortune-bundle",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-c",
        "import os,runpy;os.environ['PORT']='8002';os.environ['FF_BUNDLE']='1';runpy.run_path('server.py',run_name='__main__')"
      ],
      "port": 8002
    }
  ]
}